# Copy to .env and fill in real values. For local docker-compose dev,
# DATABASE_HOST/REDIS_URL are overridden in docker-compose.yml to point at the
# sibling postgres/redis containers regardless of what's set here.

# token secrets
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# postgresql creds
DATABASE_HOST=postgres
DATABASE_NAME=linkup
DATABASE_USER=linkup
DATABASE_PASSWORD=linkup
DATABASE_PORT=5432

# backblazeb2 creds
APPLICATION_KEY_ID=
APPLICATION_KEY=
BUCKET_NAME=
B2_ENDPOINT=

# ImageKit creds
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_ENDPOINT_URL=

# brevo creds
BREVO_API_KEY=
FROM_EMAIL=

# redis
REDIS_URL=redis://redis:6379
