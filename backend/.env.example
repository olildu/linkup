# Copy to .env and fill in real values. For local docker-compose dev,
# DATABASE_HOST/REDIS_URL are overridden in docker-compose.yml to point at the
# sibling postgres/redis containers regardless of what's set here.

# token secrets
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# postgresql creds
DATABASE_HOST=postgres
DATABASE_NAME=linkup
DATABASE_USER=linkup
DATABASE_PASSWORD=linkup
DATABASE_PORT=5432

# backblazeb2 creds
APPLICATION_KEY_ID=
APPLICATION_KEY=
BUCKET_NAME=
B2_ENDPOINT=

# ImageKit creds
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_ENDPOINT_URL=

# SeaweedFS creds (self-hosted, s3-compatible). SEAWEEDFS_S3_ENDPOINT is set
# per-environment in docker-compose (http://seaweedfs:8333), no need to set
# it here.
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_BUCKET=linkup-media

# imgproxy creds (self-hosted image transform/signing, sits in front of
# SeaweedFS). IMGPROXY_KEY/IMGPROXY_SALT must match the imgproxy container's
# own env vars of the same name. NOTE: don't name the next var
# IMGPROXY_BASE_URL - that's a *native* imgproxy env var (base URL prepended
# to source URLs) and the imgproxy container shares this same .env file via
# env_file, so that name would collide and corrupt every generated URL.
IMGPROXY_PUBLIC_URL=https://media.olildu.dpdns.org
IMGPROXY_KEY=
IMGPROXY_SALT=

# brevo creds
BREVO_API_KEY=
FROM_EMAIL=

# redis
REDIS_URL=redis://redis:6379

# status/logs page (X-Status-Token header on GET /api/v1/internal/status)
STATUS_PAGE_TOKEN=change-me
